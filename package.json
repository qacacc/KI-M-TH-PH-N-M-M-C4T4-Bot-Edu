{
  "name": "campus-assistant-local",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "free:dev-port": "node tools/free-dev-port.cjs",
    "clean:dev-port": "npm run free:dev-port",
    "dev:web": "vite --host 127.0.0.1",
    "dev": "npm run dev:web",
    "dev:desktop": "npm run free:dev-port && npm run tauri dev",
    "dev:tauri": "npm run dev:desktop",
    "dev:app": "npm run dev:desktop",
    "build": "tsc && vite build",
    "build:installer": "npm run tauri build",
    "build:release": "npm run check:all && npm run build:installer",
    "test": "vitest run",
    "test:layout": "node tools/layout-regression-check.cjs",
    "preview": "vite preview",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:all",
    "check:postman": "node tools/check-postman.cjs && node tools/check-local-postman.cjs",
    "sync:postman": "node tools/sync-postman.cjs --write",
    "check:all": "npm run test && npm run test:layout && npm run check:postman && npm run build && npm run check:rust && npm run test:rust && npm audit",
    "build:dev-launcher": "rustc --edition=2021 tools/dev-launcher.rs -o CampusAssistantLocal-Dev.exe",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.12"
  }
}
