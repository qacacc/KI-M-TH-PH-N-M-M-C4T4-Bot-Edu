{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Campus Assistant Local",
  "version": "1.0.1",
  "identifier": "local.campus.assistant",
  "build": {
    "beforeDevCommand": "npm run free:dev-port && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Campus Assistant Local",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
